# Copy to .env and set strong unique secrets. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///smart_banking.db

# Optional Stripe Checkout deposits. Use a Stripe test secret key for demos.
STRIPE_SECRET_KEY=

# Optional Razorpay TEST credentials. Do not use live keys for classroom demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional SMTP email delivery configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
